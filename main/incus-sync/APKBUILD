# Maintainer: UniDoc <ahall@unidoc.io>
pkgname=incus-sync
pkgver=0.2.0
pkgrel=0
pkgdesc="Declarative GitOps fleet manager for Incus"
url="https://github.com/unidoc/incus-sync"
arch="all"
license="Apache-2.0"
# incus-sync shells out to incus, sops, git and sh - all behind an
# exec.LookPath guard or busybox-provided (internal/incus/client.go,
# cmd_vault.go, cmd_remote.go, internal/gitcheck/gitcheck.go), so nothing
# crashes on a bare Alpine box without them. No hard depends="incus":
# internal/incus/client.go supports remote hosts (ConnectIncus(r.URL, ...))
# as well as the local unix socket, so the tool genuinely runs off-host.
# git and sops are recommended, not required, for the fleet workflow.
makedepends="go"
options="net" # go mod needs network at build time

# Alpine's go package defaults to GOTOOLCHAIN=local, which refuses a go.mod that asks for a newer Go than Alpine
# packages (Alpine 3.24 has 1.26.8). GOTOOLCHAIN=auto lets Go fetch the toolchain a release asks for (and changes
# nothing when the installed Go is new enough); options="net" permits the fetch. Not hermetic, but the fetch is
# checksum-verified through the Go checksum database. Every package that builds with go sets this
# (scripts/check-apkbuilds.sh enforces it).
export GOTOOLCHAIN=auto
source="$pkgname-$pkgver.tar.gz::https://github.com/unidoc/incus-sync/archive/refs/tags/v$pkgver.tar.gz"
builddir="$srcdir/$pkgname-$pkgver"

build() {
	# Same as the Justfile's `build` recipe (ldflags, version stamping),
	# plus -trimpath: without it Go embeds the builder's absolute srcdir
	# path in the binary (confirmed: 41 occurrences without, 0 with).
	CGO_ENABLED=0 go build -trimpath -ldflags="-s -w -X main.version=$pkgver" -o incus-sync ./cmd/incus-sync
}

check() {
	CGO_ENABLED=0 go test ./...
}

package() {
	install -Dm755 incus-sync "$pkgdir"/usr/bin/incus-sync

	# Upstream's Justfile installs this as part of a normal install; the
	# subcommand needs no fleet config or incus socket to generate it.
	./incus-sync completion bash > incus-sync.bash
	install -Dm644 incus-sync.bash \
		"$pkgdir"/usr/share/bash-completion/completions/incus-sync
}

sha512sums="
7858879e437fc1482cb90e7f96f13c960de7663cf4e1cce0621e3e1f46d0c962c690a4fef5a5e561c7678e82118992fdcc0701d87b0d5d72d5883b9c9da434c5  incus-sync-0.2.0.tar.gz
"
