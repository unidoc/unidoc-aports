# Maintainer: UniDoc <ahall@unidoc.io>
pkgname=unidoc-ndppd
pkgver=1.0.0
pkgrel=0
pkgdesc="IPv6 NDP proxy daemon - UniDoc fork of ndppd"
url="https://github.com/unidoc/unidoc-ndppd"
arch="all"
license="GPL-3.0-or-later"
makedepends="linux-headers"
source="$pkgname-$pkgver.tar.gz::https://github.com/unidoc/unidoc-ndppd/archive/refs/tags/v$pkgver.tar.gz
	unidoc-ndppd.initd
	unidoc-ndppd.confd
	"
builddir="$srcdir/$pkgname-$pkgver"

build() {
	# VERSION explicit, not left to the Makefile's `git describe` fallback -
	# abuild's extracted tarball has no .git dir, so that fallback would
	# silently bake in "dev" instead of the real release version.
	make VERSION="v$pkgver"
}

# No check() - unidoc-ndppd has no -h/--help or any other no-op flag
# (getopt string is literally "c:dp:u:v", confirmed against src/ndppd.c) to
# smoke-test against without a real config file and network privileges,
# so there's nothing meaningful to run here at build time.

package() {
	make DESTDIR="$pkgdir" PREFIX=/usr install

	install -Dm644 contrib/unidoc-ndppd.conf-dist "$pkgdir"/etc/unidoc-ndppd.conf
	install -Dm755 "$srcdir"/unidoc-ndppd.initd "$pkgdir"/etc/init.d/unidoc-ndppd
	install -Dm644 "$srcdir"/unidoc-ndppd.confd "$pkgdir"/etc/conf.d/unidoc-ndppd
}

