# Maintainer: UniDoc <ahall@unidoc.io>
pkgname=age-plugin-sshagent
pkgver=0.1.0
pkgrel=0
pkgdesc="age plugin deriving X25519 identities from ssh-agent signatures - UniDoc fork of eszio/age-plugin-sshagent"
url="https://github.com/unidoc/age-plugin-sshagent"
arch="all"
license="BSD-3-Clause"
makedepends="go"
options="net" # go mod needs network at build time
source="$pkgname-$pkgver.tar.gz::https://github.com/unidoc/age-plugin-sshagent/archive/refs/tags/v$pkgver.tar.gz"
builddir="$srcdir/$pkgname-$pkgver"

build() {
	# Same as the Justfile's `build` recipe (ldflags, version stamping).
	CGO_ENABLED=0 go build -trimpath -ldflags "-s -w -X main.version=$pkgver" -o age-plugin-sshagent .
}

check() {
	CGO_ENABLED=0 go test ./...
}

package() {
	install -Dm755 age-plugin-sshagent "$pkgdir"/usr/bin/age-plugin-sshagent
}

sha512sums="
