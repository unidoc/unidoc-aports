#!/sbin/openrc-run

# App config (DATABASE_URL, ISMS_DATA_DIR, ...) lives in
# /etc/isms/server.env, plain KEY=VALUE, loaded NATIVELY by isms
# itself via ISMS_SERVER_ENV (see cmd/isms/main.go upstream) - this
# script never sources it, and it never needs to be shell-exported.
# /etc/conf.d/isms only carries OpenRC-level knobs (ISMS_ARGS, an
# ISMS_SERVER_ENV override) - same separation upstream's own FreeBSD
# rc.d script (contrib/freebsd/rc.d/isms) and the Debian packaging
# already use, just pointed at isms's own built-in loader instead of
# the manual `set -a; . file; set +a` FreeBSD's rc.d has to do by hand
# (daemon(8) has no equivalent of ISMS_SERVER_ENV to lean on).
command="/usr/bin/isms"
command_args="server serve ${ISMS_ARGS}"
command_user="isms:isms"
command_background="true"
pidfile="/run/isms.pid"
output_log="/var/log/isms/isms.log"
error_log="/var/log/isms/isms.log"

export ISMS_SERVER_ENV="${ISMS_SERVER_ENV:-/etc/isms/server.env}"

depend() {
	need net
	use postgresql
}

# _server_env_get KEY - reads one KEY=VALUE line out of $ISMS_SERVER_ENV
# (last matching line wins, same order os.Setenv gives loadEnvFile() on
# a repeated key), stripping one matching pair of surrounding quotes -
# same shape loadEnvFile() itself parses. The one place this file reads
# a value out of server.env, so ISMS_DATA_DIR/ISMS_SECRET below share it
# instead of each reimplementing the same sed+quote-strip.
_server_env_get() {
	v=$(sed -n "s/^$1=//p" "$ISMS_SERVER_ENV" | tail -n1)
	v=${v%\"}; v=${v#\"}
	v=${v%\'}; v=${v#\'}
	printf '%s' "$v"
}

start_pre() {
	checkpath --directory --owner isms:isms --mode 0750 /var/log/isms

	if [ ! -r "$ISMS_SERVER_ENV" ]; then
		eerror "$ISMS_SERVER_ENV is not readable - the isms package ships a template there; fill it in, or point ISMS_SERVER_ENV (in /etc/conf.d/isms) at a different file"
		return 1
	fi

	# ISMS_SECRET: generated once, on the first start that finds it
	# genuinely empty, and never touched again after that - see
	# server.env's own comment on why this must never silently
	# regenerate (it's the JWT signing key AND the key that OIDC
	# client secrets are encrypted at rest with - rotating it
	# invalidates every live session and makes every already-encrypted
	# OIDC secret undecryptable). Reads straight from /dev/urandom via
	# od rather than shelling out to openssl - both are already part
	# of this image's own base tools, no extra depends= needed just
	# for this.
	if [ -z "$(_server_env_get ISMS_SECRET)" ]; then
		einfo "ISMS_SECRET is empty in $ISMS_SERVER_ENV - generating one (first start only)"
		secret=$(head -c 32 /dev/urandom | od -An -tx1 | tr -d ' \n')
		if grep -q '^ISMS_SECRET=' "$ISMS_SERVER_ENV"; then
			sed "s|^ISMS_SECRET=.*|ISMS_SECRET=$secret|" "$ISMS_SERVER_ENV" > "$ISMS_SERVER_ENV.tmp" \
				&& mv "$ISMS_SERVER_ENV.tmp" "$ISMS_SERVER_ENV"
		else
			printf 'ISMS_SECRET=%s\n' "$secret" >> "$ISMS_SERVER_ENV"
		fi
	fi

	# isms:isms (the user this service actually runs as, see
	# command_user above) needs read access to its own config -
	# enforced on every start, not just at package-install time, so a
	# manual `chmod`/package upgrade (or the ISMS_SECRET generation
	# above, which runs as root) that resets this gets fixed
	# automatically instead of failing confusingly at daemon startup.
	checkpath --file --owner isms:isms --mode 0600 "$ISMS_SERVER_ENV"

	# ISMS_DATA_DIR itself lives in server.env, not in this script's
	# own shell environment - read it out directly, same as
	# ISMS_SECRET above. isms does not create this top-level directory
	# itself (it DOES create repos/ and orgs/ under it on demand - see
	# server.env's own comment) - see server.env's own comment on it.
	data_dir=$(_server_env_get ISMS_DATA_DIR)
	checkpath --directory --owner isms:isms --mode 0750 "${data_dir:-/var/lib/isms}"

	# /var/lib/isms/private - the SSH signing key's own home. 0700,
	# tighter than ISMS_DATA_DIR's own 0750 - this one only ever holds
	# a private key.
	checkpath --directory --owner isms:isms --mode 0700 "${data_dir:-/var/lib/isms}/private"

	# ISMS_SIGNING_KEY: generated once, on the first start that finds
	# the key file missing - same "generate once, never touch again"
	# shape as ISMS_SECRET above, but gated on a real ISMS_SIGNING_EMAIL
	# first: every commit isms writes gets signed AS this identity (see
	# server.env's own comment), and unlike ISMS_SECRET (pure random
	# bytes) a real email address is a human decision, not something to
	# default. Refuses to start rather than silently generating a key
	# tied to the shipped CHANGEME placeholder - the case pattern below
	# matches it case-insensitively, same as a plain `grep -i changeme`
	# would, just without shelling out to grep for one string compare.
	signing_key=$(_server_env_get ISMS_SIGNING_KEY)
	if [ -n "$signing_key" ] && [ ! -e "$signing_key" ]; then
		signing_email=$(_server_env_get ISMS_SIGNING_EMAIL)
		case "$signing_email" in
			"" | *[Cc][Hh][Aa][Nn][Gg][Ee][Mm][Ee]*)
				eerror "ISMS_SIGNING_EMAIL in $ISMS_SERVER_ENV is still unset or the shipped CHANGEME placeholder - set it to a real address before this can generate $signing_key"
				return 1
				;;
		esac
		einfo "ISMS_SIGNING_KEY ($signing_key) does not exist yet - generating it (first start only)"
		ssh-keygen -q -t ed25519 -N "" -C "$signing_email" -f "$signing_key" </dev/null
		checkpath --file --owner isms:isms --mode 0600 "$signing_key"
	fi
}
