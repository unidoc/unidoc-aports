# isms app config - plain KEY=VALUE, loaded natively by isms itself
# (ISMS_SERVER_ENV, see cmd/isms/main.go upstream), no shell export
# needed. Full list: github.com/unidoc/isms/docs.
#
# Contains secrets (DATABASE_URL, S3 keys) - installed mode 0600, and
# isms.initd's own start_pre() enforces isms:isms ownership + 0600 on
# every start (checkpath), same idiom it already uses for /var/lib/isms.
# OpenRC-level knobs (extra CLI args, an override path for this file)
# live in /etc/conf.d/isms instead - NOT app config, see that file.

# --- Required - isms aborts at startup if these are unset ---

# PostgreSQL connection.
DATABASE_URL="postgres://isms:CHANGEME@127.0.0.1:5432/isms?sslmode=disable"

# Master key (min 32 chars) - JWT signing, and derived into the key that
# encrypts OIDC client secrets at rest. Left BLANK here on purpose: isms.initd's
# own start_pre() generates a real random one (openssl-independent: read
# straight from /dev/urandom) and writes it back into this file on first
# start, if and only if this line is still empty - never touches it again
# once real content is there. Restoring a backup onto a fresh install? Put
# the OLD value here yourself before first start - the generator only ever
# fills a genuinely empty line, so a real value here always wins.
ISMS_SECRET=

# Per-org bare git repos live at $ISMS_DATA_DIR/repos/{slug}.git; with the
# "file" storage backend, branding + evidence blobs live here too. Owned by
# the isms user - isms.initd creates it on first start.
ISMS_DATA_DIR=/var/lib/isms

# "file" keeps blobs under ISMS_DATA_DIR; "s3" needs the ISMS_S3_* vars below.
ISMS_STORAGE_BACKEND=file

# Standard templates repo on disk - this package ships none; clone your
# org's own templates repo here yourself, AS THE isms USER (matches
# ISMS_DATA_DIR's own ownership, so isms can actually read it):
#   su -s /bin/sh isms -c 'git clone <url> /var/lib/isms/templates'
# MUST be a full (working-tree) clone, never --bare: isms reads template
# files straight off disk (os.ReadDir/os.ReadFile - see
# internal/isms/scaffold/templates.go), and a bare clone has no working
# tree at all for it to find anything in.
ISMS_TEMPLATE_PATH=/var/lib/isms/templates

# SSH commit signing - the isms code itself treats this as optional
# (unsigned commits if left unset, see internal/isms/api/server.go), but
# UniDoc policy is every install signs. ISMS_SIGNING_EMAIL is a real
# decision (isms.sh's own git commits get signed AS this identity) so it
# stays config, same as DATABASE_URL above - but the KEY ITSELF is
# mechanical, so isms.initd's own start_pre() generates it for you, the
# same "generate once on first start, never touch again" shape as
# ISMS_SECRET, with one extra gate: it refuses to start (not just skip
# signing) if ISMS_SIGNING_EMAIL is still empty or the CHANGEME
# placeholder below, rather than silently generating a key tied to a
# bogus identity. Set a real email, then just start the service - no
# manual ssh-keygen needed. Key format is a plain OpenSSH ed25519
# private key (ssh.ParsePrivateKey - see internal/isms/store/git.go),
# exactly what `ssh-keygen -t ed25519` writes.
ISMS_SIGNING_KEY=/var/lib/isms/private/isms_key
ISMS_SIGNING_NAME=isms.sh
ISMS_SIGNING_EMAIL=CHANGEME@example.com

# --- Common ---
#ISMS_BASE_URL=https://isms.example.com
#ISMS_CORS_ORIGIN=https://isms.example.com
#ISMS_USER_SIGNUP=false

# S3/R2 backend (only when ISMS_STORAGE_BACKEND=s3):
#ISMS_S3_BUCKET=isms
#ISMS_S3_ENDPOINT=https://...
#ISMS_S3_ACCESS_KEY=...
#ISMS_S3_SECRET_KEY=...
