# isms app config - plain KEY=VALUE, loaded natively by isms itself
# (ISMS_SERVER_ENV, see cmd/isms/main.go upstream), no shell export
# needed. Full list: github.com/unidoc/isms/docs.
#
# Contains secrets (DATABASE_URL, S3 keys) - installed mode 0600, and
# isms.initd's own start_pre() enforces isms:isms ownership + 0600 on
# every start (checkpath), same idiom it already uses for /var/lib/isms.
# OpenRC-level knobs (extra CLI args, an override path for this file)
# live in /etc/conf.d/isms instead - NOT app config, see that file.

# --- Required - isms aborts at startup if these are unset ---

# PostgreSQL connection.
DATABASE_URL="postgres://isms:CHANGEME@127.0.0.1:5432/isms?sslmode=disable"

# Per-org bare git repos live at $ISMS_DATA_DIR/repos/{slug}.git; with the
# "file" storage backend, branding + evidence blobs live here too. Owned by
# the isms user - isms.initd creates it on first start.
ISMS_DATA_DIR=/var/lib/isms

# "file" keeps blobs under ISMS_DATA_DIR; "s3" needs the ISMS_S3_* vars below.
ISMS_STORAGE_BACKEND=file

# Standard templates repo on disk - this package ships none; point this at
# your org's clone.
ISMS_TEMPLATE_PATH=/var/lib/isms/templates

# --- Common ---
#ISMS_BASE_URL=https://isms.example.com
#ISMS_CORS_ORIGIN=https://isms.example.com
#ISMS_USER_SIGNUP=false

# S3/R2 backend (only when ISMS_STORAGE_BACKEND=s3):
#ISMS_S3_BUCKET=isms
#ISMS_S3_ENDPOINT=https://...
#ISMS_S3_ACCESS_KEY=...
#ISMS_S3_SECRET_KEY=...
