# Maintainer: UniDoc <ahall@unidoc.io>
#
# r1: app config (DATABASE_URL, S3 keys, ...) moved out of
# /etc/conf.d/isms into a dedicated /etc/isms/server.env, mode 0600 -
# isms.confd used to ship the same secrets mode 0644 (world-readable).
# isms itself already has a native env-file loader (ISMS_SERVER_ENV,
# see cmd/isms/main.go upstream) matching the FreeBSD/Debian packaging
# convention (a dedicated server.env), so this also drops the manual
# per-var shell `export` gymnastics conf.d needed. See isms.confd's and
# isms.initd's own header comments for the full story.
#
# r2: three real gaps found deploying the first server.env-based install
# (demo.isms.sh) - see isms.server.env's and isms.initd's own comments
# for each:
#   - ISMS_SECRET (required - server.go log.Fatal's without it) was
#     missing from server.env entirely; isms.initd's start_pre() now
#     generates and persists a real one on first start, only ever if the
#     line is genuinely empty.
#   - ISMS_TEMPLATE_PATH's own comment now says outright that it must be
#     a full working-tree clone, never --bare (confirmed against
#     internal/isms/scaffold/templates.go's plain os.ReadDir/os.ReadFile
#     reads) - repos/ and orgs/ under ISMS_DATA_DIR need no packaging
#     help at all, isms itself os.MkdirAll's both on demand.
#   - /etc/profile.d/isms.sh exports ISMS_SERVER_ENV for interactive
#     shells too - isms.initd only ever exported it for the daemon's own
#     process, so `isms server migrate` run by hand had no way to find
#     server.env on its own.
pkgname=isms
pkgver=0.8.0
pkgrel=2
pkgdesc="Open-source ISMS platform - git-native documents, PostgreSQL collaboration, single binary"
url="https://github.com/unidoc/isms"
arch="all"
license="Apache-2.0"
makedepends="go nodejs npm"
install="$pkgname.pre-install"
options="net" # go mod + npm ci both need network at build time
source="$pkgname-$pkgver.tar.gz::https://github.com/unidoc/isms/archive/refs/tags/v$pkgver.tar.gz
	isms.initd
	isms.confd
	isms.server.env
	isms.profile.d
	"
builddir="$srcdir/$pkgname-$pkgver"

# CGO_ENABLED=0 pure Go binary using go-git internally (no external `git`
# binary needed at runtime, confirmed from cmd/isms/main.go's imports) - no
# runtime depends= at all. isms only ever talks to Postgres over the network
# (DATABASE_URL), it doesn't need a `psql` binary on the box to do that; add
# postgresql-client yourself if you actually want an interactive client.

build() {
	# Mirrors the upstream Justfile's `build-go` recipe exactly (sync
	# migrations + build the Vue frontend + copy its dist/ into cmd/isms/
	# for go:embed) rather than depending on `just` as a build tool.
	./scripts/sync-migrations.sh

	(
		cd web
		npm ci
		npm run build
	)
	mkdir -p cmd/isms/web/dist
	cp -r web/dist/. cmd/isms/web/dist/

	CGO_ENABLED=0 go build -trimpath \
		-ldflags "-s -w -X main.version=$pkgver -X main.commitHash=release -X main.commitCount=0" \
		-o isms ./cmd/isms
}

check() {
	CGO_ENABLED=0 go test ./internal/isms/... -count=1 -timeout 120s
}

package() {
	install -Dm755 isms "$pkgdir"/usr/bin/isms
	install -Dm755 "$srcdir"/isms.initd "$pkgdir"/etc/init.d/isms
	install -Dm644 "$srcdir"/isms.confd "$pkgdir"/etc/conf.d/isms
	# 0600, not 0644 like isms.confd above - this file holds real
	# secrets (DATABASE_URL, S3 keys), isms.confd used to too and
	# shipped world-readable (see isms.confd's own header comment for
	# the full story). isms.initd's own start_pre() re-enforces
	# isms:isms ownership + this same mode on every start (checkpath),
	# since package()-time install can't chown to a system user that
	# doesn't exist yet in the build sandbox.
	install -Dm600 "$srcdir"/isms.server.env "$pkgdir"/etc/isms/server.env
	# /etc/profile.d/*.sh - standard Alpine convention, sourced by
	# /etc/profile for every login shell. Exports ISMS_SERVER_ENV so an
	# admin command run BY HAND (isms server migrate, ...) finds
	# server.env the same way the daemon itself already does - see
	# isms.profile.d's own header comment for the real gap this closes.
	install -Dm644 "$srcdir"/isms.profile.d "$pkgdir"/etc/profile.d/isms.sh
}

