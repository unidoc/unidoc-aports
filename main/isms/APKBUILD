# Maintainer: UniDoc <ahall@unidoc.io>
#
# r1: app config (DATABASE_URL, S3 keys, ...) moved out of
# /etc/conf.d/isms into a dedicated /etc/isms/server.env, mode 0600 -
# isms.confd used to ship the same secrets mode 0644 (world-readable).
# isms itself already has a native env-file loader (ISMS_SERVER_ENV,
# see cmd/isms/main.go upstream) matching the FreeBSD/Debian packaging
# convention (a dedicated server.env), so this also drops the manual
# per-var shell `export` gymnastics conf.d needed. See isms.confd's and
# isms.initd's own header comments for the full story.
#
# r2: four real gaps found deploying the first server.env-based install
# (demo.isms.sh) - see isms.server.env's and isms.initd's own comments
# for each:
#   - ISMS_SECRET (required - server.go log.Fatal's without it) was
#     missing from server.env entirely; isms.initd's start_pre() now
#     generates and persists a real one on first start, only ever if the
#     line is genuinely empty.
#   - ISMS_TEMPLATE_PATH's own comment now says outright that it must be
#     a full working-tree clone, never --bare (confirmed against
#     internal/isms/scaffold/templates.go's plain os.ReadDir/os.ReadFile
#     reads) - repos/ and orgs/ under ISMS_DATA_DIR need no packaging
#     help at all, isms itself os.MkdirAll's both on demand.
#   - /etc/profile.d/isms.sh exports ISMS_SERVER_ENV for interactive
#     shells too - isms.initd only ever exported it for the daemon's own
#     process, so `isms server migrate` run by hand had no way to find
#     server.env on its own.
#   - ISMS_SIGNING_KEY/NAME/EMAIL are real server.env config now too
#     (moved out of the commented "optional" block) - UniDoc policy is
#     every install signs its commits. isms.initd's start_pre() now
#     generates the actual key itself (`ssh-keygen -t ed25519`, same
#     "once on first start" shape as ISMS_SECRET) - but refuses to start
#     rather than generate one if ISMS_SIGNING_EMAIL is still empty or
#     the shipped CHANGEME placeholder, since that part IS a human
#     decision. New openssh-keygen depends= for this (confirmed as a
#     real, separate Alpine subpackage via a live `apk search openssh`).
#
# r3: independent Fable-model audit (fleet-scale review: hundreds of
# Incus instances, apk-upgraded together) of this package against the
# real isms source and the real isms-templates repo. Headline finding:
# the one existential fleet risk - `apk upgrade` clobbering a live,
# secret-bearing /etc/isms/server.env - does NOT happen, confirmed
# directly against apk-tools' own source (apk_db_migrate_files,
# database.c): a locally-modified file under a protected path ("+etc"
# is a built-in default) is never overwritten, the new package version
# lands as <path>.apk-new instead. Real gaps the audit DID find, all
# fixed here:
#   - CRITICAL: ISMS_BASE_URL was listed as optional (under "Common"),
#     but server.go log.Fatal's at startup without it (or
#     ISMS_CORS_ORIGIN) outside ISMS_DEV_MODE=1 - moved to Required.
#   - isms.initd used command_background (bare start-stop-daemon
#     fork-and-forget) - any post-fork crash (exactly what the
#     ISMS_BASE_URL gap above would cause) was invisible: OpenRC reports
#     "started", nothing ever respawns it. Switched to supervise-daemon
#     (real supervision, respawn_delay=5/respawn_max=0 - never
#     permanently gives up, confirmed against supervise-daemon.c's own
#     "respawn_max > 0" gate).
#   - A locally-modified server.env/conf.d never picks up a NEWER
#     package version's added config (that's the flip side of the
#     apk-upgrade protection above) - isms.initd's start_pre() now warns
#     loudly on every start if a <file>.apk-new sibling exists, instead
#     of leaving that silent.
#   - No log rotation for /var/log/isms/isms.log (Echo logs every HTTP
#     request) - unbounded growth across long-lived instances. New
#     isms.logrotate + a real logrotate depends=, copytruncate (isms has
#     no SIGHUP-reopen handling to support anything else).
#   - _server_env_get only matched a bare "KEY=", not "KEY = " - a
#     hand-edited line with spaces around "=" would look empty to this
#     script (but not to isms's own loadEnvFile, which tolerates them)
#     and get a second, silently-winning generated value appended.
#     Tightened to match loadEnvFile's own tolerance.
#   - umask 077 added to start_pre() - the ISMS_SECRET/ISMS_SIGNING_KEY
#     generation's own sed-to-tempfile-then-mv step could otherwise
#     briefly leave a copy of the file (secrets included) at the
#     default umask before the final checkpath narrows it to 0600.
#   - ISMS_TEMPLATE_PATH was documented as if in the startup-abort
#     Required section, but it's only read lazily (fails at
#     template-listing time, not startup) - re-sectioned for accuracy.
#   - A CHANGEME ISMS_SIGNING_EMAIL set AFTER the signing key already
#     exists now gets a start-time warning (the original CHANGEME gate
#     only ran at key-generation time).
#   - isms.profile.d only reaches login shells - `incus exec <c> --
#     isms server migrate` (the natural fleet-tooling execution path)
#     is non-login and won't source it, reproducing the exact gap r2
#     fixed for other interactive contexts. Documented with the
#     `--env` workaround; no general fix exists (incus exec has no
#     login/profile sequence to hook at all).
pkgname=isms
pkgver=0.8.1
pkgrel=0
pkgdesc="Open-source ISMS platform - git-native documents, PostgreSQL collaboration, single binary"
url="https://github.com/unidoc/isms"
arch="all"
license="Apache-2.0"
makedepends="go nodejs npm"
# openssh-keygen (real, separate Alpine subpackage - confirmed via a
# live `apk search openssh`, NOT bundled into openssh-client) -
# isms.initd's own start_pre() shells out to `ssh-keygen -t ed25519` to
# generate ISMS_SIGNING_KEY on first start (see that file's own
# comment) - a real runtime dependency, not something to assume is
# already on the box.
#
# logrotate - isms.logrotate is inert without the real logrotate binary
# and its own cron job actually installed; shipping the config file
# alone would only look like unbounded /var/log/isms/isms.log growth
# was fixed, not actually fix it (see r3's own comment above).
depends="openssh-keygen logrotate"
install="$pkgname.pre-install"
options="net" # go mod + npm ci both need network at build time
source="$pkgname-$pkgver.tar.gz::https://github.com/unidoc/isms/archive/refs/tags/v$pkgver.tar.gz
	isms.initd
	isms.confd
	isms.server.env
	isms.profile.d
	isms.logrotate
	"
builddir="$srcdir/$pkgname-$pkgver"

# CGO_ENABLED=0 pure Go binary using go-git internally (no external `git`
# binary needed at runtime, confirmed from cmd/isms/main.go's imports) -
# isms itself only ever talks to Postgres over the network (DATABASE_URL),
# it doesn't need a `psql` binary on the box to do that; add
# postgresql-client yourself if you actually want an interactive client.
# openssh-keygen (above) is this package's own real runtime depends= -
# needed by isms.initd, not by the isms binary itself.

build() {
	# Mirrors the upstream Justfile's `build-go` recipe exactly (sync
	# migrations + build the Vue frontend + copy its dist/ into cmd/isms/
	# for go:embed) rather than depending on `just` as a build tool.
	./scripts/sync-migrations.sh

	(
		cd web
		npm ci
		npm run build
	)
	mkdir -p cmd/isms/web/dist
	cp -r web/dist/. cmd/isms/web/dist/

	CGO_ENABLED=0 go build -trimpath \
		-ldflags "-s -w -X main.version=$pkgver -X main.commitHash=release -X main.commitCount=0" \
		-o isms ./cmd/isms
}

check() {
	CGO_ENABLED=0 go test ./internal/isms/... -count=1 -timeout 120s
}

package() {
	install -Dm755 isms "$pkgdir"/usr/bin/isms
	install -Dm755 "$srcdir"/isms.initd "$pkgdir"/etc/init.d/isms
	install -Dm644 "$srcdir"/isms.confd "$pkgdir"/etc/conf.d/isms
	# 0600, not 0644 like isms.confd above - this file holds real
	# secrets (DATABASE_URL, S3 keys), isms.confd used to too and
	# shipped world-readable (see isms.confd's own header comment for
	# the full story). isms.initd's own start_pre() re-enforces
	# isms:isms ownership + this same mode on every start (checkpath),
	# since package()-time install can't chown to a system user that
	# doesn't exist yet in the build sandbox.
	install -Dm600 "$srcdir"/isms.server.env "$pkgdir"/etc/isms/server.env
	# /etc/profile.d/*.sh - standard Alpine convention, sourced by
	# /etc/profile for every login shell. Exports ISMS_SERVER_ENV so an
	# admin command run BY HAND (isms server migrate, ...) finds
	# server.env the same way the daemon itself already does - see
	# isms.profile.d's own header comment for the real gap this closes.
	install -Dm644 "$srcdir"/isms.profile.d "$pkgdir"/etc/profile.d/isms.sh
	install -Dm644 "$srcdir"/isms.logrotate "$pkgdir"/etc/logrotate.d/isms
}

