# isms server config - env vars, not flags (matches upstream's own
# contrib/freebsd/isms.env.sample). Full list: github.com/unidoc/isms/docs.
#
# Everything below except ISMS_ARGS is `export`ed on purpose: OpenRC's
# conf.d is just sourced (`. /etc/conf.d/isms`), not `set -a`'d, so an
# unexported var here never reaches the isms process's environment once
# the init script execs into start-stop-daemon - it would silently vanish
# and isms would fail at startup with "DATABASE_URL is required". ISMS_ARGS
# is the one exception: isms.initd interpolates it directly into
# command_args in the same shell that sources this file, so it never needs
# to survive into a child process's environment.

# --- Required - isms aborts at startup if these are unset ---

# PostgreSQL connection.
export DATABASE_URL="postgres://isms:CHANGEME@127.0.0.1:5432/isms?sslmode=disable"

# Per-org bare git repos live at $ISMS_DATA_DIR/repos/{slug}.git; with the
# "file" storage backend, branding + evidence blobs live here too. Owned by
# the isms user - isms.initd creates it on first start.
export ISMS_DATA_DIR="/var/lib/isms"

# "file" keeps blobs under ISMS_DATA_DIR; "s3" needs the ISMS_S3_* vars below.
export ISMS_STORAGE_BACKEND="file"

# Standard templates repo on disk - this package ships none; point this at
# your org's clone.
export ISMS_TEMPLATE_PATH="/var/lib/isms/templates"

# --- Common ---
#export ISMS_BASE_URL="https://isms.example.com"
#export ISMS_CORS_ORIGIN="https://isms.example.com"
#export ISMS_USER_SIGNUP=false

# S3/R2 backend (only when ISMS_STORAGE_BACKEND=s3):
#export ISMS_S3_BUCKET=isms
#export ISMS_S3_ENDPOINT=https://...
#export ISMS_S3_ACCESS_KEY=...
#export ISMS_S3_SECRET_KEY=...

# Extra args appended to `isms server serve`, e.g. --addr 127.0.0.1:8080
# (default :8080). Not exported - see note above, this one's consumed by
# isms.initd itself, not by the isms process's environment.
ISMS_ARGS=""
