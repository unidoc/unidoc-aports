# isms OpenRC startup parameters - NOT app config. App config
# (DATABASE_URL, ISMS_DATA_DIR, ISMS_STORAGE_BACKEND, ...) lives in
# /etc/isms/server.env instead, loaded natively by isms itself (see
# that file's own header comment) - putting it here too was the old
# design and got real secrets (DATABASE_URL, S3 keys) shipped in a
# world-readable file (isms.confd used to install mode 0644); fixed by
# moving it to a dedicated, mode-0600 file instead of conf.d.

# Path to the KEY=VALUE env file isms loads itself (native support -
# ISMS_SERVER_ENV, see cmd/isms/main.go upstream). Override only if
# server.env lives somewhere else.
#ISMS_SERVER_ENV="/etc/isms/server.env"

# Extra args appended to `isms server serve`, e.g. --addr 127.0.0.1:8080
# (default :8080).
ISMS_ARGS=""
