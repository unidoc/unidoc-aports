# Maintainer: UniDoc <ahall@unidoc.io>
#
# cmd/cli only - not the wails v3 GUI/server target. Confirmed by actually
# trying the server build first: `go install` for the wails3 codegen CLI
# pulls in github.com/wailsapp/wails/v3/internal/operatingsystem, which has
# an unconditional pkg-config check for gtk4 + webkitgtk-6.0 - a real,
# heavy GUI-toolkit build dependency just to compile a codegen tool, for a
# binary that never touches a display at runtime. Not worth it for what
# this repo needs. cmd/cli has zero wails/CGO dependency (grepped the
# actual source myself, not just trusted a docs claim) - a one-shot stdout
# PDF inspection tool (dump/validate/diff subcommands), nothing else.
pkgname=pdfdebug
pkgver=0.5.0
pkgrel=0
pkgdesc="UniDoc PDF Debugger - CLI PDF inspection tool (dump/validate/diff)"
url="https://github.com/unidoc/pdfdebug"
arch="all"
license="Apache-2.0"
makedepends="go"
options="net" # go mod needs network at build time
source="$pkgname-$pkgver.tar.gz::https://github.com/unidoc/pdfdebug/archive/refs/tags/v$pkgver.tar.gz"
builddir="$srcdir/$pkgname-$pkgver"

# pdfdebug's go.mod wants a newer Go than Alpine 3.24 packages (0.5.0: go>=1.27.0, Alpine has 1.26.8; re-check at
# each pkgver bump). Alpine's go package defaults GOTOOLCHAIN=local, which refuses that outright; options="net"
# above permits the fetch and this makes Go fetch the toolchain it asks for (checksum-verified through the Go
# checksum database). Not hermetic, but there is no other lever until Alpine's go catches up - the same approach as
# main/unidoc-incus.
export GOTOOLCHAIN=auto

build() {
	CGO_ENABLED=0 go build -trimpath -ldflags "-s -w" -o pdfdebug ./cmd/cli
}

package() {
	install -Dm755 pdfdebug "$pkgdir"/usr/bin/pdfdebug
}

sha512sums="
73e74334b92cdae93d3f48aed2b6da7047143afe2ed910bb9187d5f0a9f313e931f7966dd0065005444dd68a2c1819af6ba4a6f3386706409ec33e7cde983a38  pdfdebug-0.5.0.tar.gz
"
